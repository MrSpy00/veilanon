# ============================================================================
# veilanon environment variables
# Copy to `.env` and fill in the values. All values are intentionally empty.
# Never commit a filled `.env` (it is gitignored).
# ============================================================================

# --- Supabase (control plane: auth, presence, encrypted metadata envelopes) ---
VEILANON_SUPABASE_URL=
VEILANON_SUPABASE_ANON_KEY=
VEILANON_SUPABASE_SERVICE_ROLE_KEY=
VEILANON_SUPABASE_DB_URL=

# --- LiveKit (voice / video / screen share; token signed with HS256) ---------
VEILANON_LIVEKIT_URL=
VEILANON_LIVEKIT_API_KEY=
VEILANON_LIVEKIT_API_SECRET=

# --- Cloudflare R2 (encrypted blob storage; blobs are AES-256-GCM client-side)
VEILANON_R2_ACCOUNT_ID=
VEILANON_R2_ACCESS_KEY_ID=
VEILANON_R2_SECRET_ACCESS_KEY=
VEILANON_R2_BUCKET=

# --- Observability (errors only; content is never sent to Sentry) ------------
VEILANON_SENTRY_DSN=

# --- Upstash Redis (presence fanout, rate limiting, ephemeral queues) --------
VEILANON_UPSTASH_REDIS_REST_URL=
VEILANON_UPSTASH_REDIS_REST_TOKEN=

# --- Qdrant (optional vector index; self-hostable) ---------------------------
VEILANON_QDRANT_URL=
VEILANON_QDRANT_API_KEY=

# --- Discord bridge (policy-compliant OAuth2 application, no user tokens) ----
VEILANON_DISCORD_CLIENT_ID=
VEILANON_DISCORD_CLIENT_SECRET=

# --- GIF search (chat GIF picker; free keys from tenor.com / giphy.com) ------
VEILANON_TENOR_API_KEY=
VEILANON_GIPHY_API_KEY=

# --- Local AI (optional; Ollama at localhost for the privacy settings toggle)
VEILANON_OLLAMA_URL=http://localhost:11434
