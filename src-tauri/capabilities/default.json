{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Default veilanon capabilities — minimal privilege, scoped filesystem and opener",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:tray:default",
    "core:path:default",
    "core:event:default",
    "core:app:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/com.aegissoft.veilanon/**" }, { "path": "$APPDATA/com.aegissoft.veilanon" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/com.aegissoft.veilanon/**" }, { "path": "$APPDATA/com.aegissoft.veilanon" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA/com.aegissoft.veilanon/**" }, { "path": "$APPDATA/com.aegissoft.veilanon" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/com.aegissoft.veilanon/**" }, { "path": "$APPDATA/com.aegissoft.veilanon" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/com.aegissoft.veilanon/**" }, { "path": "$APPDATA/com.aegissoft.veilanon" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/com.aegissoft.veilanon/**" }, { "path": "$APPDATA/com.aegissoft.veilanon" }]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    {
      "identifier": "shell:allow-open",
      "allow": [{ "path": "$APPDATA/com.aegissoft.veilanon/**" }]
    },
    "notification:default",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "process:default",
    "process:allow-restart",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "global-shortcut:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" },
        { "url": "mailto:**" },
        { "url": "tel:**" }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "$APPDATA/com.aegissoft.veilanon/**" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/com.aegissoft.veilanon/**" }]
    },
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "deep-link:default"
  ]
}
